{
  "name": "lanwash-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:pages": "tsc --noEmit && vite build --base=/LanWash-Landing/",
    "build:clients": "tsc --noEmit && vite build --mode clients --outDir dist/clients",
    "build:business": "tsc --noEmit && vite build --mode business --outDir dist/business",
    "build:subdomains": "tsc --noEmit && vite build --mode clients --outDir dist/clients && vite build --mode business --outDir dist/business"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
