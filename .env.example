# Leave empty to show the download placeholder.
VITE_ANDROID_DOWNLOAD_URL=
# Two deployment addresses: fill when the subdomains are selected.
# Until then "For business" / "For clients" switch audiences on the same site.
VITE_CLIENT_SITE_URL=
VITE_BUSINESS_SITE_URL=
# clients (default) or business; build:subdomains sets it per build.
VITE_SITE_AUDIENCE=clients
# «LanWash Бизнес» в RuStore (бизнес-версия сайта).
VITE_BUSINESS_RUSTORE_URL=
# Сервер LanWash для анкеты подключения мойки (по умолчанию https://lanwash.ru).
VITE_API_URL=
